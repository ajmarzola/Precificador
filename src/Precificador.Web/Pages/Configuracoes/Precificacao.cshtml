@page
@model Precificador.Web.Pages.Configuracoes.PrecificacaoModel
@using Precificador.Web.Apresentacao
@{
    ViewData["Title"] = "Configurações de precificação";
    var configuracao = Model.Configuracao!;
}

<h1>Configurações de precificação</h1>
<p class="text-muted">Empresa ativa: @Model.EmpresaNome</p>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">@Model.MensagemSucesso</div>
}

<dl class="row">
    <dt class="col-sm-4">Valor da hora de trabalho</dt>
    <dd class="col-sm-8">
        @ConfiguracaoPrecificacaoFormatacao.Monetario(configuracao.ValorHoraTrabalho)
        <div class="form-text">@ConfiguracaoPrecificacaoAjuda.ValorHoraTrabalho</div>
    </dd>

    <dt class="col-sm-4">Tarifa de energia (R$/kWh)</dt>
    <dd class="col-sm-8">
        @ConfiguracaoPrecificacaoFormatacao.Monetario(configuracao.TarifaEnergiaKwh)
        <div class="form-text">@ConfiguracaoPrecificacaoAjuda.TarifaEnergiaKwh</div>
    </dd>

    <dt class="col-sm-4">Margem padrão para novos produtos (%)</dt>
    <dd class="col-sm-8">
        @ConfiguracaoPrecificacaoFormatacao.Percentual(configuracao.MargemPadrao)
        <div class="form-text">@ConfiguracaoPrecificacaoAjuda.MargemPadrao</div>
    </dd>

    <dt class="col-sm-4">Incremento comercial de arredondamento</dt>
    <dd class="col-sm-8">
        @ConfiguracaoPrecificacaoFormatacao.Monetario(configuracao.IncrementoComercial)
        <div class="form-text">@ConfiguracaoPrecificacaoAjuda.IncrementoComercial</div>
    </dd>

    <dt class="col-sm-4">Reserva comercial para desconto (%)</dt>
    <dd class="col-sm-8">
        @ConfiguracaoPrecificacaoFormatacao.Percentual(configuracao.ReservaComercialDesconto)
        <div class="form-text">@ConfiguracaoPrecificacaoAjuda.ReservaComercial</div>
    </dd>
</dl>

<a class="btn btn-primary" asp-page="/Configuracoes/Precificacao/Editar">Alterar configurações</a>
