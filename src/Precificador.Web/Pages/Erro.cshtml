@page "/Erro/{codigo:int}"
@model ErroModel
@{
    Layout = "_LayoutErro";
    ViewData["Title"] = Model.Titulo;
}
<h1>@Model.Titulo</h1>
<p>@Model.Mensagem</p>
@if (Model.Referencia is not null)
{
    <p><strong>Referência:</strong> <code>@Model.Referencia</code></p>
}
<a class="btn btn-primary" href="/">Voltar ao início</a>
