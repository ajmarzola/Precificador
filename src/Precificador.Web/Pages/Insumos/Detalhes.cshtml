@page "{id:int}"
@model Precificador.Web.Pages.Insumos.DetalhesModel
@using Precificador.Web.Apresentacao
@{
    ViewData["Title"] = "Consultar insumo";
    var insumo = Model.Insumo!;
}
<h1>Consultar insumo</h1>
@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">@Model.MensagemSucesso</div>
}
<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@insumo.Nome</dd>
    <dt class="col-sm-3">Marca</dt><dd class="col-sm-9">@(insumo.Marca ?? "—")</dd>
    <dt class="col-sm-3">Categoria</dt><dd class="col-sm-9">@InsumoRotulos.Categoria(insumo.Categoria)</dd>
    <dt class="col-sm-3">Unidade base</dt><dd class="col-sm-9">@InsumoRotulos.Unidade(insumo.UnidadeBase)</dd>
    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(insumo.Ativo ? "Ativo" : "Inativo")</dd>
    <dt class="col-sm-3">Observação</dt><dd class="col-sm-9" style="white-space: pre-wrap">@(insumo.Observacao ?? "—")</dd>
</dl>
<a asp-page="/Insumos/Editar" asp-route-id="@RouteData.Values["id"]" class="btn btn-primary">Editar</a>
<a asp-page="/Insumos/Precos/Novo" asp-route-id="@RouteData.Values["id"]" class="btn btn-outline-primary">Registrar preço</a>
@if (insumo.Ativo)
{
    <form method="post" asp-page-handler="Desativar" class="d-inline">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deseja desativar este insumo?');">Desativar</button>
    </form>
}
else
{
    <form method="post" asp-page-handler="Reativar" class="d-inline">
        <button type="submit" class="btn btn-outline-success">Reativar</button>
    </form>
}
<a asp-page="/Insumos/Index">Voltar para insumos</a>
