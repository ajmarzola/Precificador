@page "{id:int}"
@model Precificador.Web.Pages.Insumos.Precos.HistoricoModel
@using Precificador.Web.Apresentacao
@{
    ViewData["Title"] = "Histórico de preços do insumo";
    var insumo = Model.Insumo!;
}

<h1>Histórico de preços do insumo</h1>

<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@insumo.Nome</dd>
    <dt class="col-sm-3">Marca</dt><dd class="col-sm-9">@(insumo.Marca ?? "—")</dd>
    <dt class="col-sm-3">Unidade base</dt><dd class="col-sm-9">@InsumoRotulos.Unidade(insumo.UnidadeBase)</dd>
    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(insumo.Ativo ? "Ativo" : "Inativo")</dd>
</dl>

<section class="mb-4">
    <h2 class="h4">Preço vigente</h2>
    @if (Model.PrecoVigente is null)
    {
        <p>Sem preço vigente.</p>
    }
    else
    {
        var preco = Model.PrecoVigente;
        <dl class="row">
            <dt class="col-sm-3">Referência</dt><dd class="col-sm-9">@PrecoInsumoFormatacao.Data(preco.DataReferencia)</dd>
            <dt class="col-sm-3">Quantidade</dt><dd class="col-sm-9">@PrecoInsumoFormatacao.Quantidade(preco.QuantidadeCompra) @InsumoRotulos.Unidade(insumo.UnidadeBase)</dd>
            <dt class="col-sm-3">Preço total</dt><dd class="col-sm-9">@PrecoInsumoFormatacao.PrecoTotal(preco.PrecoCompra)</dd>
            <dt class="col-sm-3">Custo unitário</dt><dd class="col-sm-9">@PrecoInsumoFormatacao.CustoUnitario(preco.CustoUnitario) por @InsumoRotulos.Unidade(insumo.UnidadeBase)</dd>
        </dl>
    }
</section>

@if (Model.Historico.Count == 0)
{
    <p>Nenhum preço registrado para este insumo.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Data</th>
                <th>Status</th>
                <th>Quantidade</th>
                <th>Preço total</th>
                <th>Custo unitário</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var preco in Model.Historico)
        {
            <tr>
                <td>@PrecoInsumoFormatacao.Data(preco.DataReferencia)</td>
                <td>@preco.Status</td>
                <td>@PrecoInsumoFormatacao.Quantidade(preco.QuantidadeCompra) @InsumoRotulos.Unidade(insumo.UnidadeBase)</td>
                <td>@PrecoInsumoFormatacao.PrecoTotal(preco.PrecoCompra)</td>
                <td>@PrecoInsumoFormatacao.CustoUnitario(preco.CustoUnitario)</td>
            </tr>
        }
        </tbody>
    </table>
}

<a asp-page="/Insumos/Precos/Novo" asp-route-id="@RouteData.Values["id"]" class="btn btn-primary">Registrar novo preço</a>
<a asp-page="/Insumos/Detalhes" asp-route-id="@RouteData.Values["id"]" class="btn btn-secondary">Voltar ao insumo</a>
