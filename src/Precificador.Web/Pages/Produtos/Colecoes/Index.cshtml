@page
@model Precificador.Web.Pages.Produtos.Colecoes.IndexModel
@{
    ViewData["Title"] = "Coleções";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Coleções</h1>
    <a class="btn btn-primary" asp-page="/Produtos/Colecoes/Novo">Nova coleção</a>
</div>
@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">@Model.MensagemSucesso</div>
}
@if (Model.Colecoes.Count == 0)
{
    <p>Não há coleções cadastradas para a empresa ativa.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Nome</th><th>Lançamento</th><th>Finalização</th><th>Situação</th><th>Categorias</th><th></th></tr></thead>
        <tbody>
        @foreach (var colecao in Model.Colecoes)
        {
            <tr>
                <td>@colecao.Nome</td>
                <td>@colecao.DataLancamento.ToString("dd/MM/yyyy")</td>
                <td>@(colecao.DataFinalizacao?.ToString("dd/MM/yyyy") ?? "Em aberto")</td>
                <td>@colecao.SituacaoTexto</td>
                <td>@(colecao.Categorias.Count == 0 ? "—" : string.Join(", ", colecao.Categorias))</td>
                <td><a asp-page="/Produtos/Colecoes/Editar" asp-route-id="@colecao.Id">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
}
<a asp-page="/Produtos/Index">Voltar para produtos</a>
