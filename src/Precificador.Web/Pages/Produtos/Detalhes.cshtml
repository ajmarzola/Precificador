@page "{id:int}"
@model Precificador.Web.Pages.Produtos.DetalhesModel
@using Precificador.Web.Apresentacao
@{
    ViewData["Title"] = "Consultar produto";
    var produto = Model.Produto!;
    var precificacao = Model.Precificacao!;
}
<h1>Consultar produto</h1>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">@Model.MensagemSucesso</div>
}

<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@produto.Nome</dd>
    <dt class="col-sm-3">Categoria</dt><dd class="col-sm-9">@(produto.Categoria ?? "—")</dd>
    <dt class="col-sm-3">Margem-alvo</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(produto.MargemAlvo)</dd>
    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(produto.Ativo ? "Ativo" : "Inativo")</dd>
</dl>

<section class="mb-4">
    <h2 class="h4">Margem atual</h2>
    @if (precificacao.PrecoPrateleiraAtual is null)
    {
        <p>Preço de prateleira atual: não definido.</p>
    }
    <dl class="row">
        <dt class="col-sm-3">Custo unitário atual</dt>
        <dd class="col-sm-9">@(precificacao.CustoUnitarioProduto is decimal custo ? PrecoInsumoFormatacao.CustoCalculado(custo) : "indisponível")</dd>

        <dt class="col-sm-3">Preço de prateleira atual</dt>
        <dd class="col-sm-9">@(precificacao.PrecoPrateleiraAtual is decimal preco ? PrecoInsumoFormatacao.CustoCalculado(preco) : "não definido.")</dd>

        @if (precificacao.DataReferenciaPrecoAtual is DateOnly dataReferencia)
        {
            <dt class="col-sm-3">Referência do preço</dt>
            <dd class="col-sm-9">@PrecoInsumoFormatacao.Data(dataReferencia)</dd>
        }

        <dt class="col-sm-3">Margem-alvo</dt>
        <dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(precificacao.MargemAlvo)</dd>

        <dt class="col-sm-3">Margem atual</dt>
        <dd class="col-sm-9">@(precificacao.MargemAtual is decimal margem ? ProdutoFormatacao.MargemAlvo(margem) : "indisponível")</dd>

        <dt class="col-sm-3">Situação</dt>
        <dd class="col-sm-9">@DetalhesModel.SituacaoMargemRotulo(precificacao.SituacaoMargem)</dd>
    </dl>

    @if (precificacao.SituacaoMargem == Precificador.Core.Precificacao.SituacaoMargemProduto.Incompleto
        && precificacao.ImpedimentosMargemAtual.Count > 0)
    {
        <ul>
            @foreach (var impedimento in precificacao.ImpedimentosMargemAtual)
            {
                <li>@impedimento</li>
            }
        </ul>
    }
</section>

<a asp-page="/Produtos/Editar" asp-route-id="@produto.Id" class="btn btn-primary">Editar</a>
<a asp-page="/Produtos/FichaTecnica" asp-route-id="@produto.Id" class="btn btn-outline-primary">Ficha técnica</a>
<a asp-page="/Produtos/Precificacao" asp-route-id="@produto.Id" class="btn btn-outline-primary">Detalhar precificação</a>
<a asp-page="/Produtos/Precos/Novo" asp-route-id="@produto.Id" class="btn btn-outline-primary">Registrar preço de prateleira</a>
<a asp-page="/Produtos/Precos/Historico" asp-route-id="@produto.Id" class="btn btn-outline-secondary">Histórico de precificação</a>
@if (produto.Ativo)
{
    <form method="post" asp-page-handler="Desativar" asp-route-id="@produto.Id" class="d-inline">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deseja desativar este produto?');">Desativar</button>
    </form>
}
else
{
    <form method="post" asp-page-handler="Reativar" asp-route-id="@produto.Id" class="d-inline">
        <button type="submit" class="btn btn-outline-success">Reativar</button>
    </form>
}
<a asp-page="/Produtos/Index">Voltar para produtos</a>
