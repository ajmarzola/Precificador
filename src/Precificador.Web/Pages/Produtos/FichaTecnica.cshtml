@page "{id:int}"
@model Precificador.Web.Pages.Produtos.FichaTecnicaModel
@{
    ViewData["Title"] = "Ficha técnica";
    var produto = Model.Produto!;
}

<h1>Ficha técnica</h1>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">@Model.MensagemSucesso</div>
}
@if (Model.MensagemAviso is not null)
{
    <div class="alert alert-warning" role="alert">@Model.MensagemAviso</div>
}

<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@produto.Nome</dd>
    <dt class="col-sm-3">Categoria</dt><dd class="col-sm-9">@(produto.Categoria ?? "—")</dd>
    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(produto.Ativo ? "Ativo" : "Inativo")</dd>
</dl>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Rendimento" class="form-label">Rendimento do lote (unidades de venda)</label>
        <input asp-for="Input.Rendimento" class="form-control" />
        <span asp-validation-for="Input.Rendimento" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.TempoAtivoMinutos" class="form-label">Tempo ativo de trabalho (minutos)</label>
        <input asp-for="Input.TempoAtivoMinutos" class="form-control" />
        <span asp-validation-for="Input.TempoAtivoMinutos" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    @if (Model.PossuiFicha)
    {
        <a asp-page="/Produtos/FichaTecnica/Itens/Novo" asp-route-produtoId="@produto.Id" class="btn btn-outline-primary">Adicionar insumo</a>
        <a asp-page="/Produtos/FichaTecnica/Equipamentos/Novo" asp-route-produtoId="@produto.Id" class="btn btn-outline-primary">Adicionar equipamento</a>
    }
    <a asp-page="/Produtos/Detalhes" asp-route-id="@produto.Id" class="btn btn-secondary">Voltar para o produto</a>
</form>

@if (Model.PossuiFicha)
{
    <h2 class="h4 mt-4">Itens da ficha</h2>
    @if (Model.Itens.Count == 0)
    {
        <p>Nenhum insumo adicionado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Insumo</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Quantidade</th>
                    <th scope="col">Unidade</th>
                    <th scope="col">Perda esperada (%)</th>
                    <th scope="col">Custo unitário</th>
                    <th scope="col">Custo do item</th>
                    <th scope="col">Custo da perda</th>
                    <th scope="col">Observação contextual</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Marca) ? "—" : item.Marca)</td>
                        <td>@item.QuantidadeFormatada</td>
                        <td>@item.UnidadeFormatada</td>
                        <td>@item.PercentualPerdaFormatado</td>
                        <td>@item.CustoUnitarioFormatado</td>
                        <td>@item.CustoItemFormatado</td>
                        <td>@item.CustoPerdaFormatado</td>
                        <td style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(item.Observacao) ? "—" : item.Observacao)</td>
                        <td>@item.Situacao</td>
                        <td>
                            <a asp-page="/Produtos/FichaTecnica/Itens/Editar"
                               asp-route-produtoId="@produto.Id"
                               asp-route-itemId="@item.Id">Editar</a>
                            <a asp-page="/Produtos/FichaTecnica/Itens/Remover"
                               asp-route-produtoId="@produto.Id"
                               asp-route-itemId="@item.Id">Remover</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <p class="mt-3">
        <strong>Custo base dos itens:</strong>
        @if (Model.CustoBaseItensCompleto)
        {
            @Model.CustoBaseItensFormatado
        }
        else
        {
            <text>indisponível</text>
        }
    </p>
    @if (!Model.CustoBaseItensCompleto)
    {
        <p>
            @(Model.Itens.Count == 0
                ? "A ficha não possui itens."
                : "Há item(ns) sem preço vigente.")
        </p>
    }

    <p class="mt-3">
        <strong>Custo de perdas do lote:</strong>
        @if (Model.CustoPerdasCompleto)
        {
            @Model.CustoPerdasLoteFormatado
        }
        else
        {
            <text>indisponível</text>
        }
    </p>
    @if (!Model.CustoPerdasCompleto)
    {
        <p>Há perda(s) sem custo base determinável.</p>
    }

    <p class="mt-3">
        <strong>Custo de mão de obra do lote:</strong>
        @if (Model.CustoMaoDeObraCompleto)
        {
            @Model.CustoMaoDeObraLoteFormatado
        }
        else
        {
            <text>indisponível</text>
        }
    </p>
    @if (!Model.CustoMaoDeObraCompleto)
    {
        <p>Valor da hora de trabalho não configurado.</p>
    }

    <h2 class="h4 mt-4">Equipamentos</h2>
    @if (Model.UsosEquipamentos.Count == 0) { <p>Nenhum equipamento adicionado.</p> }
    else { <table class="table"><thead><tr><th scope="col">Equipamento</th><th scope="col">Potência (kW)</th><th scope="col">Tempo (min)</th><th scope="col">Consumo (kWh)</th><th scope="col">Custo de energia</th><th scope="col">Ações</th></tr></thead><tbody>@foreach (var uso in Model.UsosEquipamentos) { <tr><td>@uso.NomeEquipamento</td><td>@uso.PotenciaFormatada</td><td>@uso.TempoUsoMinutos</td><td>@uso.ConsumoFormatado</td><td>@uso.CustoFormatado</td><td><a asp-page="/Produtos/FichaTecnica/Equipamentos/Editar" asp-route-produtoId="@produto.Id" asp-route-usoId="@uso.Id">Editar</a> <a asp-page="/Produtos/FichaTecnica/Equipamentos/Remover" asp-route-produtoId="@produto.Id" asp-route-usoId="@uso.Id">Remover</a></td></tr> }</tbody></table> }
    <p class="mt-3"><strong>Custo de energia do lote:</strong> @(Model.CustoEnergiaCompleto ? Model.CustoEnergiaLoteFormatado : "indisponível")</p>
    @if (!Model.CustoEnergiaCompleto) { <p>Tarifa de energia não configurada.</p> }

    <h2 class="h4 mt-4">Custo do produto</h2>
    <p><strong>Custo total do lote:</strong> @(Model.CustoProdutoCompleto ? Model.CustoLoteFormatado : "indisponível")</p>
    <p><strong>Rendimento:</strong> @FichaTecnicaFormulario.FormatarRendimento(Model.RendimentoAtual!.Value)</p>
    <p><strong>Custo unitário do produto:</strong> @(Model.CustoProdutoCompleto ? Model.CustoUnitarioProdutoFormatado : "indisponível")</p>
    @if (!Model.CustoProdutoCompleto)
    {
        <p>Precificação incompleta.</p>
    }

    <h2 class="h4 mt-4">Preço do produto</h2>
    <p><strong>Margem-alvo:</strong> @Precificador.Web.Apresentacao.ProdutoFormatacao.MargemAlvo(produto.MargemAlvo)</p>
    <p><strong>Preço teórico:</strong> @(Model.PrecoTeoricoFormatado ?? "indisponível")</p>
    <p><strong>Preço sugerido:</strong> @(Model.PrecoSugeridoFormatado ?? "indisponível")</p>
    @if (!Model.PrecoProdutoCompleto)
    {
        @if (Model.CustoUnitarioProduto is not null && Model.PrecoSugerido is null)
        {
            <p>Incremento comercial não configurado.</p>
        }
        <p>Precificação incompleta.</p>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
