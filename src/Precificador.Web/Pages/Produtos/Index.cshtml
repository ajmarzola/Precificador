@page
@model Precificador.Web.Pages.Produtos.IndexModel
@using Precificador.Web.Apresentacao
@{
    ViewData["Title"] = "Produtos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Produtos</h1>
    <div>
        <a class="btn btn-outline-primary" asp-page="/Produtos/Categorias/Index">Categorias de produto</a>
        <a class="btn btn-primary" asp-page="/Produtos/Novo">Cadastrar produto</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-5">
        <label for="q" class="visually-hidden">Pesquisar produtos</label>
        <input id="q" name="q" value="@Model.Consulta" class="form-control" placeholder="Pesquisar por nome" />
    </div>
    <div class="col-sm-4">
        <label for="categoria" class="visually-hidden">Categoria</label>
        <select id="categoria" name="categoria" asp-items="Model.Categorias" class="form-select"></select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Pesquisar</button></div>
</form>

@if (Model.Produtos.Count == 0)
{
    if (Model.TemFiltros)
    {
        <p>Nenhum produto encontrado para os filtros informados.</p>
        <p><a asp-page="/Produtos/Index">Limpar filtros</a></p>
    }
    else
    {
        <p>Não há produtos cadastrados para a empresa ativa.</p>
    }
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead><tr><th>Nome</th><th>Categoria</th><th>Custo unitário atual</th><th>Preço de prateleira vigente</th><th>Margem atual</th><th>Margem-alvo</th><th>Situação</th><th>Consultar</th></tr></thead>
        <tbody>
        @foreach (var produto in Model.Produtos)
        {
            <tr>
                <td>@produto.Nome</td><td>@(produto.Categoria ?? "—")</td><td>@(produto.CustoUnitarioProduto is decimal custo ? PrecoInsumoFormatacao.CustoCalculado(custo) : "indisponível")</td><td>@(produto.PrecoPrateleiraAtual is decimal preco ? PrecoInsumoFormatacao.CustoCalculado(preco) : "—")</td><td>@(produto.MargemAtual is decimal margem ? ProdutoFormatacao.MargemAlvo(margem) : "indisponível")</td><td>@ProdutoFormatacao.MargemAlvo(produto.MargemAlvo)</td><td>@(produto.Ativo ? "Ativo" : "Inativo")</td>
                <td><a asp-page="/Produtos/Detalhes" asp-route-id="@produto.Id">Consultar</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
