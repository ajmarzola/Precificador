@page
@model Precificador.Web.Pages.Produtos.NovoModel
@{
    ViewData["Title"] = "Cadastrar produto";
}

<h1>Cadastrar produto</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Nome" class="form-label"></label>
        <input asp-for="Input.Nome" class="form-control" />
        <span asp-validation-for="Input.Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CategoriaProdutoId" class="form-label"></label>
        <select asp-for="Input.CategoriaProdutoId" asp-items="Model.CategoriasDisponiveis" class="form-select"></select>
        <span asp-validation-for="Input.CategoriaProdutoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.MargemAlvoPercentual" class="form-label"></label>
        <input asp-for="Input.MargemAlvoPercentual" class="form-control" />
        <span asp-validation-for="Input.MargemAlvoPercentual" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
