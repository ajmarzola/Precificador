@page "{id:int}"
@model Precificador.Web.Pages.Produtos.PrecificacaoModel
@using Precificador.Web.Apresentacao
@using Precificador.Web.Pages.Produtos.FichaTecnica.Itens
@using Precificador.Web.Pages.Produtos.FichaTecnica.Equipamentos
@{
    ViewData["Title"] = "Detalhamento da precificação";
    var produto = Model.Produto!;
    var resultado = Model.Resultado!;
    string Valor(decimal? valor) => valor is decimal conhecido ? PrecoInsumoFormatacao.CustoCalculado(conhecido) : "indisponível";
    string Configuracao(decimal? valor) => valor is decimal conhecido ? PrecoInsumoFormatacao.CustoCalculado(conhecido) : "Não configurado";
    string Percentual(decimal? valor) => valor.HasValue ? ProdutoFormatacao.MargemAlvo(valor.Value) : "indisponível";
    string Data(DateOnly? valor) => valor.HasValue ? PrecoInsumoFormatacao.Data(valor.Value) : "não definida";
    string Rendimento(decimal? valor) => valor.HasValue ? FichaTecnicaFormulario.FormatarRendimento(valor.Value) : "Não disponível";
}
<h1>Detalhamento da precificação</h1>

<section class="mb-4"><h2 class="h4">Produto</h2><dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@produto.Nome</dd>
    <dt class="col-sm-3">Categoria</dt><dd class="col-sm-9">@(produto.Categoria ?? "—")</dd>
    <dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@(produto.Ativo ? "Ativo" : "Inativo")</dd>
</dl></section>

<section class="mb-4"><h2 class="h4">Estado da precificação</h2><dl class="row">
    <dt class="col-sm-3">Situação da margem</dt><dd class="col-sm-9">@PrecificacaoModel.SituacaoRotulo(resultado.SituacaoMargem)</dd>
    <dt class="col-sm-3">Margem-alvo</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(resultado.MargemAlvo)</dd>
    <dt class="col-sm-3">Margem atual</dt><dd class="col-sm-9">@Percentual(resultado.MargemAtual)</dd>
    <dt class="col-sm-3">Preço de prateleira atual</dt><dd class="col-sm-9">@(resultado.PrecoPrateleiraAtual.HasValue ? PrecoInsumoFormatacao.CustoCalculado(resultado.PrecoPrateleiraAtual.Value) : "não definido.")</dd>
    <dt class="col-sm-3">Data de referência</dt><dd class="col-sm-9">@Data(resultado.DataReferenciaPrecoAtual)</dd>
    <dt class="col-sm-3">Preço sugerido</dt><dd class="col-sm-9">@Valor(resultado.PrecoSugerido)</dd>
</dl>
@if (resultado.ImpedimentosMargemAtual.Count > 0) { <ul>@foreach (var impedimento in resultado.ImpedimentosMargemAtual) { <li>@impedimento</li> }</ul> }
</section>

<section class="mb-4"><h2 class="h4">Parâmetros usados</h2><dl class="row">
    <dt class="col-sm-3">Data operacional</dt><dd class="col-sm-9">@PrecoInsumoFormatacao.Data(resultado.DataOperacional)</dd>
    <dt class="col-sm-3">Rendimento</dt><dd class="col-sm-9">@Rendimento(resultado.Rendimento)</dd>
    <dt class="col-sm-3">Mão de obra sobre os insumos</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(resultado.PercentualMaoDeObra ?? 0m)</dd>
    <dt class="col-sm-3">Tarifa de energia</dt><dd class="col-sm-9">@Configuracao(resultado.TarifaEnergiaKwh)</dd>
    <dt class="col-sm-3">Incremento comercial</dt><dd class="col-sm-9">@Configuracao(resultado.IncrementoComercial)</dd>
    <dt class="col-sm-3">Margem-alvo</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(resultado.MargemAlvo)</dd>
</dl></section>

<section class="mb-4"><h2 class="h4">Itens e perdas</h2>
@if (!Model.PossuiFicha) { <p>Ficha técnica: não cadastrada.</p> } else if (Model.Itens.Count == 0) { <p>Nenhum insumo adicionado.</p> } else { <table class="table"><thead><tr><th>Insumo</th><th>Marca</th><th>Situação</th><th>Quantidade</th><th>Unidade</th><th>Custo unitário atual</th><th>Custo base</th><th>Perda esperada</th><th>Custo da perda</th></tr></thead><tbody>@foreach (var item in Model.Itens) { <tr><td>@item.Nome</td><td>@(item.Marca ?? "—")</td><td>@(item.Ativo ? "Ativo" : "Inativo")</td><td>@ItemFichaTecnicaFormulario.FormatarQuantidade(item.Quantidade)</td><td>@InsumoRotulos.Unidade(item.Unidade)</td><td>@(item.CustoUnitario is decimal custoUnitario ? PrecoInsumoFormatacao.CustoUnitario(custoUnitario) : "Sem preço vigente")</td><td>@Valor(item.CustoItem)</td><td>@(ItemFichaTecnicaFormulario.FormatarPercentualPerda(item.PercentualPerda) + "%")</td><td>@Valor(item.CustoPerdaItem)</td></tr> }</tbody></table> }
<p><strong>Custo base dos itens:</strong> @Valor(resultado.CustoBaseItens)</p><p><strong>Custo de perdas do lote:</strong> @Valor(resultado.CustoPerdasLote)</p>
</section>

<section class="mb-4"><h2 class="h4">Mão de obra</h2><dl class="row"><dt class="col-sm-3">Base da mão de obra</dt><dd class="col-sm-9">@Valor(resultado.CustoBaseItens)</dd><dt class="col-sm-3">Percentual de mão de obra</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(resultado.PercentualMaoDeObra ?? 0m)</dd><dt class="col-sm-3">Custo de mão de obra do lote</dt><dd class="col-sm-9">@Valor(resultado.CustoMaoDeObraLote)</dd></dl></section>

<section class="mb-4"><h2 class="h4">Equipamentos e energia</h2>
@if (!Model.PossuiFicha || Model.Usos.Count == 0) { <p>Nenhum equipamento adicionado.</p> } else { <table class="table"><thead><tr><th>Equipamento</th><th>Potência (kW)</th><th>Tempo de uso (min)</th><th>Consumo (kWh)</th><th>Custo de energia</th></tr></thead><tbody>@foreach (var uso in Model.Usos) { <tr><td>@uso.NomeEquipamento</td><td>@UsoEquipamentoFichaFormulario.FormatarPotencia(uso.PotenciaKw)</td><td>@uso.TempoUsoMinutos</td><td>@(uso.ConsumoKwh is decimal consumo ? UsoEquipamentoFichaFormulario.FormatarConsumo(consumo) : "indisponível")</td><td>@Valor(uso.CustoEnergiaUso)</td></tr> }</tbody></table> }
<p><strong>Tarifa de energia atual:</strong> @Configuracao(resultado.TarifaEnergiaKwh)</p><p><strong>Custo de energia do lote:</strong> @Valor(resultado.CustoEnergiaLote)</p>
</section>

<section class="mb-4"><h2 class="h4">Consolidação do custo</h2><dl class="row"><dt class="col-sm-3">Custo base dos itens</dt><dd class="col-sm-9">@Valor(resultado.CustoBaseItens)</dd><dt class="col-sm-3">Custo de perdas</dt><dd class="col-sm-9">@Valor(resultado.CustoPerdasLote)</dd><dt class="col-sm-3">Custo de mão de obra</dt><dd class="col-sm-9">@Valor(resultado.CustoMaoDeObraLote)</dd><dt class="col-sm-3">Custo de energia</dt><dd class="col-sm-9">@Valor(resultado.CustoEnergiaLote)</dd><dt class="col-sm-3">Custo total do lote</dt><dd class="col-sm-9">@Valor(resultado.CustoLote)</dd><dt class="col-sm-3">Rendimento</dt><dd class="col-sm-9">@Rendimento(resultado.Rendimento)</dd><dt class="col-sm-3">Custo unitário do produto</dt><dd class="col-sm-9">@Valor(resultado.CustoUnitarioProduto)</dd></dl></section>

<section class="mb-4"><h2 class="h4">Formação do preço</h2><dl class="row"><dt class="col-sm-3">Custo unitário</dt><dd class="col-sm-9">@Valor(resultado.CustoUnitarioProduto)</dd><dt class="col-sm-3">Margem-alvo</dt><dd class="col-sm-9">@ProdutoFormatacao.MargemAlvo(resultado.MargemAlvo)</dd><dt class="col-sm-3">Preço teórico</dt><dd class="col-sm-9">@Valor(resultado.PrecoTeorico)</dd><dt class="col-sm-3">Incremento comercial</dt><dd class="col-sm-9">@Configuracao(resultado.IncrementoComercial)</dd><dt class="col-sm-3">Preço sugerido</dt><dd class="col-sm-9">@Valor(resultado.PrecoSugerido)</dd></dl></section>

<section class="mb-4"><h2 class="h4">Situação comercial atual</h2><dl class="row"><dt class="col-sm-3">Preço de prateleira atual</dt><dd class="col-sm-9">@(resultado.PrecoPrateleiraAtual.HasValue ? PrecoInsumoFormatacao.CustoCalculado(resultado.PrecoPrateleiraAtual.Value) : "não definido.")</dd><dt class="col-sm-3">Data de referência</dt><dd class="col-sm-9">@Data(resultado.DataReferenciaPrecoAtual)</dd><dt class="col-sm-3">Margem atual</dt><dd class="col-sm-9">@Percentual(resultado.MargemAtual)</dd><dt class="col-sm-3">Situação</dt><dd class="col-sm-9">@PrecificacaoModel.SituacaoRotulo(resultado.SituacaoMargem)</dd></dl></section>

<section class="mb-4"><h2 class="h4">Pendências da precificação</h2>@if (resultado.Impedimentos.Count == 0) { <p>Nenhuma pendência de cálculo.</p> } else { <ul>@foreach (var impedimento in resultado.Impedimentos) { <li>@impedimento</li> }</ul> }</section>

<a asp-page="/Produtos/Detalhes" asp-route-id="@produto.Id" class="btn btn-secondary">Voltar ao produto</a>
<a asp-page="/Produtos/FichaTecnica" asp-route-id="@produto.Id" class="btn btn-outline-primary">Editar Ficha técnica</a>
<a asp-page="/Produtos/Precos/Novo" asp-route-id="@produto.Id" class="btn btn-outline-primary">Registrar preço de prateleira</a>
<a asp-page="/Produtos/Precos/Historico" asp-route-id="@produto.Id" class="btn btn-outline-secondary">Histórico de precificação</a>